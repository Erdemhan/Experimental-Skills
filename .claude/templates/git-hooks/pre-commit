#!/bin/sh
# ============================================================
# pre-commit hook — Kod kalitesi kontrolü
#
# Kurulum:
#   cp .claude/templates/git-hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# NOT: pre-commit framework kullanıyorsanız bu dosya yerine
# .pre-commit-config.yaml kullanın (daha güçlü).
# ============================================================

echo "🔍 pre-commit kontrolleri çalışıyor..."

# ---- Hangi dosyalar değişti? ----
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep "\.py$")
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM)

# ---- 1. Büyük dosya kontrolü (100MB+) ----
for file in $STAGED_ALL; do
    if [ -f "$file" ]; then
        size=$(wc -c < "$file")
        if [ "$size" -gt 104857600 ]; then  # 100MB
            echo "❌ Büyük dosya engellendi: $file ($(($size / 1048576))MB)"
            echo "   Git LFS kullanmayı düşünün: git lfs track '$file'"
            exit 1
        fi
    fi
done

# ---- 2. Gizli dosya ve ML Model/Veri seti kontrolü ----
for file in $STAGED_ALL; do
    case "$file" in
        *.pem|*.key|*.p12|*.pfx)
            echo "❌ Olası gizli anahtar dosyası engellendi: $file"
            exit 1
            ;;
        .env)
            echo "❌ .env dosyası commit edilemez! .gitignore'a ekleyin."
            exit 1
            ;;
        *.pt|*.pth|*.ckpt|*.bin|*.onnx|*.safetensors|*.h5|*.hdf5|*.pkl|*.pickle|*.npz)
            echo "❌ Model ağırlığı / İkili veri dosyası commit edilemez: $file"
            echo "   Model ağırlıklarını ve büyük ikili verileri Git'e eklemeyin."
            exit 1
            ;;
    esac
done

# ---- 3. Python kontrolleri (Python dosyası yoksa atla) ----
if [ -n "$STAGED_PY" ]; then

    # ruff (varsa)
    if command -v ruff > /dev/null 2>&1; then
        echo "  → ruff kontrol ediliyor..."
        echo "$STAGED_PY" | xargs ruff check --quiet
        if [ $? -ne 0 ]; then
            echo "❌ ruff hataları var. 'ruff check --fix .' çalıştırın."
            exit 1
        fi
    fi

    # black format kontrolü (varsa)
    if command -v black > /dev/null 2>&1; then
        echo "  → black format kontrol ediliyor..."
        echo "$STAGED_PY" | xargs black --check --quiet 2>/dev/null
        if [ $? -ne 0 ]; then
            echo "❌ black format uyumsuzluğu. 'black .' çalıştırın."
            exit 1
        fi
    fi

fi

# ---- 4. Jupyter Notebook çıktı kontrolü (opsiyonel) ----
STAGED_NB=$(git diff --cached --name-only --diff-filter=ACM | grep "\.ipynb$")
if [ -n "$STAGED_NB" ]; then
    echo "⚠️  Jupyter Notebook commit ediliyor: $STAGED_NB"
    echo "   Çıktıları temizlemek ister misiniz? (jupyter nbconvert --clear-output)"
    echo "   Devam etmek için Ctrl+C iptal edin veya Enter'a basın..."
    # Otomatik bloklamıyoruz — kullanıcı kararı
fi

echo "✅ pre-commit kontrolleri geçti."
exit 0
