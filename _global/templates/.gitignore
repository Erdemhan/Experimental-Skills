# ============================================================
# Akademik ML/RL Araştırma Projeleri İçin .gitignore Şablonu
#
# Kurulum (yeni projenizde):
#   cp .claude/templates/.gitignore .gitignore
# ============================================================

# Python / Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# SQLite & Context Persistence (Claude Code oturum verisi)
.claude/context/context.db
.claude/context/context.db-wal
.claude/context/context.db-shm

# Büyük Veri, Model Ağırlıkları ve Sonuç Dosyaları (Akademik ML/RL)
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.safetensors
*.h5
*.hdf5
*.pkl
*.pickle
*.npz
*.npy
*.parquet
*.feather
*.csv
*.tsv

# Deney Logları, Görseller ve Ray/WandB Çıktıları
ray_results/
wandb/
mlflow/
runs/
tb_logs/
logs/
checkpoints/
models/
data/raw/
data/processed/
results/raw/
*.png
*.jpg
*.jpeg
*.pdf
*.svg

# Sanal Ortamlar
.venv/
venv/
env/
ENV/
conda-env/

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
